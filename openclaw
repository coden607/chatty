#!/bin/bash
# OpenClaw Interactive Assistant Launcher
# Usage: ./openclaw [--task "..."] [--code] [--status]

CHATTY_ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$CHATTY_ROOT"

# Check if virtual environment exists
if [ ! -d ".venv" ]; then
    echo "❌ Virtual environment not found at $CHATTY_ROOT/.venv"
    echo "Please run: python3 -m venv .venv && source .venv/bin/activate && pip install -r requirements.txt"
    exit 1
fi

# Load environment
if [ -f .env ]; then
    export $(cat .env | grep -v "^#" | xargs) 2>/dev/null
fi

# Activate and run
source .venv/bin/activate
exec python3 openclaw_assistant.py "$@"
