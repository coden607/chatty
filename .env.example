# CHATTY environment template. Copy to ~/.config/chatty/secrets.env (or .env) and fill in.
# NEVER commit real keys. Everything below is optional: missing keys just disable that source.

# ---------------------------------------------------------------- core / paths
# CHATTY_HOME=/path/to/chatty            # defaults to the repo directory
# CHATTY_SECRETS_FILE=~/.config/chatty/secrets.env

# Legacy loops are OFF by default. Set to 1 to enable.
CHATTY_ENABLE_NARCOGUARD=0
CHATTY_ENABLE_YOUTUBE=0
CHATTY_ENABLE_X=0
CHATTY_ENABLE_OPPORTUNITIES=1

# LLM (any one; used for AI email drafts + legacy agents). Agents stay disabled if none is set.
OPENROUTER_API_KEY=
XAI_API_KEY=
# OPENAI_API_KEY=
# OPP_DRAFT_MODEL=openai/gpt-4o-mini

# ------------------------------------------------------------- job finder
# Keyless and always on: Remotive, Remote OK, Himalayas, HN "Who is hiring", Greenhouse/Lever/Ashby boards.
# Adzuna (free key, https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# USAJOBS (free key, https://developer.usajobs.gov/apirequest/); USAJOBS_EMAIL must be the email you registered with
USAJOBS_API_KEY=
USAJOBS_EMAIL=

OPP_JOB_KEYWORDS=python,typescript,ai automation
OPP_JOB_TYPES=full_time,contract
OPP_REMOTE_ONLY=true
OPP_MIN_SALARY_USD=0
OPP_MIN_JOB_SCORE=40
OPP_MAX_JOB_AGE_DAYS=30
# OPP_GREENHOUSE_BOARDS=anthropic,vercel,gitlab,cloudflare,airtable
# OPP_LEVER_BOARDS=palantir,spotify
# OPP_ASHBY_BOARDS=openai,supabase,linear,ramp,notion,replit

# Daily digest. Goes ONLY to OPP_DIGEST_TO (a single address). Saved to a file if anything is missing.
RESEND_API_KEY=
OPP_DIGEST_FROM=
OPP_DIGEST_TO=
OPP_DIGEST_HOUR=8
# Identify the crawler politely (shown in the User-Agent)
OPP_CONTACT_EMAIL=

# ------------------------------------------------- Cortese prospect finder
# Keyless and always on: NPI Registry (dental + dermatology/aesthetics organizations).
# Google Places API (New): enable "Places API (New)" in Google Cloud, restrict the key to that API.
GOOGLE_PLACES_API_KEY=
OPP_PLACES_MONTHLY_BUDGET_USD=50
OPP_PLACES_COST_PER_CALL_USD=0.035
OPP_PLACES_MAX_CALLS_PER_RUN=250
OPP_PLACES_CACHE_DAYS=30
OPP_VERTICALS=dental,med_spa,home_services,law_firm,auto_repair
OPP_METRO_LIMIT=100
OPP_WEBSITE_CHECKS=true
OPP_PROSPECTS_INTERVAL_HOURS=168
OPP_JOBS_INTERVAL_HOURS=24

# Sender identity used in DRAFT emails (CAN-SPAM requires a real postal address + opt-out)
CORTESE_SENDER_NAME=Stephen Blanford
CORTESE_COMPANY=Cortese Digital
CORTESE_POSTAL_ADDRESS=
CORTESE_WEBSITE=

# ------------------------------------------------------- legacy integrations
# STRIPE_SECRET_KEY=
# SENDGRID_API_KEY=
# X_CONSUMER_KEY= / X_CONSUMER_SECRET= / X_ACCESS_TOKEN= / X_ACCESS_SECRET= / X_BEARER_TOKEN=
# NVIDIA_API_KEY=nvapi-your-key-here
