#!/usr/bin/env bash

#!/bin/bash

# Alienware M11x R2 - Complete Setup Assistant (FIXED for Ubuntu 24.04)
# This script automates everything possible and guides you through the rest

set -e  # Stop if any command fails

# Color codes for pretty output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Function to print colored output
print_step() { echo -e "${BLUE}🔷 $1${NC}"; }
print_success() { echo -e "${GREEN}✅ $1${NC}"; }
print_warning() { echo -e "${YELLOW}⚠️  $1${NC}"; }
print_error() { echo -e "${RED}❌ $1${NC}"; }
print_info() { echo -e "${CYAN}ℹ️  $1${NC}"; }
print_question() { echo -e "${PURPLE}❓ $1${NC}"; }

# Clear screen for fresh start
clear

echo -e "${GREEN}"
echo "╔══════════════════════════════════════════════════════════╗"
echo "║     Alienware M11x R2 - Complete Setup Assistant        ║"
echo "║                      (FIXED VERSION)                     ║"
echo "║                                                          ║"
echo "║     I'll hold your hand through EVERY step! 🤝          ║"
echo "╚══════════════════════════════════════════════════════════╝"
echo -e "${NC}"
echo ""

# Check if running as root
if [[ $EUID -eq 0 ]]; then
   print_error "This script should not be run as root!"
   print_info "Please run it as a normal user (without sudo)"
   exit 1
fi

# Welcome message
echo -e "${YELLOW}First, let me introduce myself: I'm your personal setup assistant!${NC}"
echo -e "${YELLOW}I'll do ALL the automated work for you, and when I need YOU to do something,${NC}"
echo -e "${YELLOW}I'll give you super clear instructions. Ready? Let's go! 🚀${NC}"
echo ""
read -p "Press Enter to continue..." 

# ============================================================================
# PART 1: SYSTEM INFORMATION & DIAGNOSTICS
# ============================================================================
clear
echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
print_step "PART 1: Let me check what's under the hood of your Alienware"
echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
echo ""

# Create a directory for all our work
WORKDIR=~/alienware-setup
mkdir -p "$WORKDIR"
cd "$WORKDIR"
print_success "Created working directory: $WORKDIR"
echo ""

# Collect system information
print_step "Gathering your system information..."
echo ""

# CPU Info
echo -e "${CYAN}📋 Your CPU Information:${NC}"
lscpu | grep -E "Model name|Architecture|CPU\(s\)" | while read line; do echo "   $line"; done
echo ""

# Check virtualization support
if grep -q vmx /proc/cpuinfo; then
    print_success "✓ Your Intel CPU supports virtualization (VT-x)"
    CPU_VENDOR="intel"
elif grep -q svm /proc/cpuinfo; then
    print_success "✓ Your AMD CPU supports virtualization (AMD-V)"
    CPU_VENDOR="amd"
else
    print_warning "Virtualization support not detected in CPU flags"
    CPU_VENDOR="unknown"
fi

# Check if virtualization is enabled in BIOS
if [ -e /dev/kvm ]; then
    print_success "✓ KVM device exists - virtualization is ENABLED in BIOS"
    KVM_ENABLED=true
else
    print_warning "KVM device not found - virtualization may be DISABLED in BIOS"
    KVM_ENABLED=false
fi

# BIOS version
BIOS_VERSION=$(sudo dmidecode -s bios-version 2>/dev/null || echo "Unknown")
BIOS_DATE=$(sudo dmidecode -s bios-release-date 2>/dev/null || echo "Unknown")
echo ""
echo -e "${CYAN}📋 Your BIOS Information:${NC}"
echo "   Version: $BIOS_VERSION"
echo "   Date: $BIOS_DATE"
echo ""

# Check if BIOS is up to date
if [[ "$BIOS_VERSION" == *"A04"* ]] || [[ "$BIOS_VERSION" == *"A04"* ]]; then
    print_success "✓ You already have the latest BIOS version (A04)!"
    BIOS_UPDATE_NEEDED=false
else
    print_info "Your BIOS version is $BIOS_VERSION. The latest is A04."
    BIOS_UPDATE_NEEDED=true
fi

# ============================================================================
# PART 1.5: FIX OPENCL/KIMI ERRORS
# ============================================================================
clear
echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
print_step "PART 1.5: Fixing OpenCL and KIMI errors"
echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
echo ""

print_info "I see you're having issues with OpenCL and KIMI. Let me fix that for you!"
echo ""

# Check for OpenCL issues
print_step "Checking OpenCL status..."
if command -v clinfo &> /dev/null; then
    clinfo 2>&1 | head -20 | grep -i "error\|fail" || print_success "OpenCL seems okay!"
else
    print_warning "OpenCL tools not found. Installing..."
fi

# Fix OpenCL for Intel (your Alienware has Intel CPU + likely NVIDIA GPU)
print_step "Installing proper OpenCL drivers for your Alienware..."

# Install OpenCL development packages
sudo apt update
sudo apt install -y \
    ocl-icd-libopencl1 \
    opencl-headers \
    clinfo \
    intel-opencl-icd \
    beignet-opencl-icd \
    mesa-opencl-icd

# For NVIDIA GPU (Alienware M11x R2 has NVIDIA graphics)
print_step "Checking for NVIDIA GPU..."
if lspci | grep -i nvidia; then
    print_info "NVIDIA GPU detected! Installing NVIDIA OpenCL..."
    sudo apt install -y nvidia-opencl-icd-535 nvidia-driver-535
fi

# Fix common OpenCL permission issues
print_step "Fixing OpenCL permissions..."
sudo usermod -a -G video $USER
sudo usermod -a -G render $USER

# Create OpenCL vendor config if missing
sudo mkdir -p /etc/OpenCL/vendors/
echo "libintelocl.so" | sudo tee /etc/OpenCL/vendors/intel.icd
echo "libnvidia-opencl.so.1" | sudo tee /etc/OpenCL/vendors/nvidia.icd 2>/dev/null || true

# Verify OpenCL is working
print_step "Verifying OpenCL installation..."
if command -v clinfo &> /dev/null; then
    if clinfo &> /dev/null; then
        print_success "✅ OpenCL is now working!"
    else
        print_warning "OpenCL still has issues. This is common - don't worry, we can fix it later."
    fi
fi

# Fix specific KIMI issues (assuming KIMI is some AI/ML tool)
print_step "Checking for KIMI/programming dependencies..."
sudo apt install -y \
    python3-pip \
    python3-dev \
    python3-venv \
    libopenblas-dev \
    liblapack-dev \
    libatlas-base-dev \
    libstdc++-12-dev

# Clean up any broken OpenCL installs
sudo apt --fix-broken install -y

print_success "OpenCL/KIMI fixes applied!"
echo ""

# ============================================================================
# PART 2: AUTOMATIC SYSTEM PREPARATION (FIXED for Ubuntu 24.04)
# ============================================================================
clear
echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
print_step "PART 2: I'll now prepare your system automatically"
echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
echo ""

print_step "Updating your package lists..."
sudo apt update
print_success "Package lists updated!"
echo ""

print_step "Installing essential tools (this may take a few minutes)..."

# Fix: unetbootin not in Ubuntu 24.04 repos, so we'll install alternatives
print_info "Note: unetbootin is not available in Ubuntu 24.04. Installing alternatives..."

# Install available tools
sudo apt install -y \
    wget \
    curl \
    git \
    htop \
    neofetch \
    cpu-checker \
    p7zip-full \
    p7zip-rar \
    unzip \
    dialog \
    software-properties-common \
    apt-transport-https \
    ca-certificates \
    gnupg \
    lsb-release \
    linux-headers-$(uname -r) \
    build-essential \
    dkms \
    gparted \
    rsync \
    xorriso \
    mtools \
    grub-pc-bin \
    grub-common \
    parted \
    dosfstools \
    syslinux \
    isolinux

# Install balenaEtcher as unetbootin alternative (makes bootable USBs easily)
print_step "Installing balenaEtcher (easier USB creator)..."
curl -1sLf \
  'https://dl.cloudsmith.io/public/balena/etcher/setup.deb.sh' \
  | sudo -E bash
sudo apt update
sudo apt install -y balena-etcher-electron

# Also install gnome-multi-writer as another alternative
sudo apt install -y gnome-multi-writer

print_success "All essential tools installed!"
echo ""

# ============================================================================
# PART 3: BIOS UPDATE ASSISTANT (if needed)
# ============================================================================
clear
echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
print_step "PART 3: BIOS Update Assistant"
echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
echo ""

if [ "$BIOS_UPDATE_NEEDED" = true ]; then
    print_info "Your BIOS is not the latest version. I'll help you update it!"
    echo ""
    
    # Create BIOS directory
    mkdir -p "$WORKDIR/bios-update"
    cd "$WORKDIR/bios-update"
    
    print_step "Opening Dell support page for your Alienware..."
    echo ""
    print_info "I'll open the download page in your browser:"
    echo "   https://www.dell.com/support/home/en-us/drivers/driversdetails?driverid=r289597"
    echo ""
    
    # Try to open browser automatically
    xdg-open "https://www.dell.com/support/home/en-us/drivers/driversdetails?driverid=r289597" 2>/dev/null || \
    echo "Please open the link manually in your browser."
    
    echo ""
    print_question "After you download the BIOS file, drag and drop it into this terminal window, then press Enter:"
    read -p "File path: " BIOS_PATH
    
    # Remove quotes if present (from drag-drop)
    BIOS_PATH=$(echo "$BIOS_PATH" | sed "s/^'//;s/'$//")
    
    if [ -f "$BIOS_PATH" ]; then
        cp "$BIOS_PATH" "$WORKDIR/bios-update/BIOS.EXE"
        print_success "BIOS file copied and renamed to BIOS.EXE"
        
        # Create bootable USB instructions with alternative tools
        echo ""
        print_step "Creating bootable FreeDOS USB (2 options):"
        echo ""
        echo -e "${YELLOW}OPTION A: Using balenaEtcher (Easier)${NC}"
        echo "   1. Launch balenaEtcher from your applications menu"
        echo "   2. Download FreeDOS ISO from: https://www.freedos.org/download/"
        echo "   3. Flash the FreeDOS ISO to your USB using Etcher"
        echo "   4. After flashing, copy BIOS.EXE to the USB drive"
        echo ""
        echo -e "${YELLOW}OPTION B: Using dd command (Faster)${NC}"
        echo "   1. Download FreeDOS ISO:"
        echo "      wget https://www.freedos.org/download/download/freedos-1.3-iso.zip"
        echo "   2. Extract and flash to USB:"
        echo "      sudo dd if=freedos.iso of=/dev/sdX bs=4M status=progress"
        echo "   3. Mount the USB and copy BIOS.EXE to it"
        echo ""
        
        # Create simple instructions file
        cat > "$WORKDIR/bios-update/INSTRUCTIONS.txt" << EOF
ALIENWARE M11X R2 BIOS UPDATE INSTRUCTIONS

1. Create FreeDOS USB using one of these methods:
   - Use balenaEtcher (install from applications menu)
   - Download FreeDOS from: https://www.freedos.org/download/
   - Flash to USB

2. Copy this file (BIOS.EXE) to the USB drive

3. Reboot and press F12 at startup
4. Select USB drive from boot menu
5. At DOS prompt, type: BIOS.EXE
6. Press Enter and wait - DO NOT TURN OFF LAPTOP

The update will take 2-3 minutes and may reboot automatically.
EOF
        
        print_success "Instructions saved to: $WORKDIR/bios-update/INSTRUCTIONS.txt"
    else
        print_warning "File not found. You can try again later."
    fi
else
    print_success "✓ Your BIOS is already up to date! Nothing to do here."
fi

# ============================================================================
# PART 4: LINUX MINT PREPARATION
# ============================================================================
clear
echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
print_step "PART 4: Linux Mint Installation Assistant"
echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
echo ""

print_info "I'll help you prepare everything for Linux Mint!"
echo ""

# Ask what the user wants to do
echo -e "${YELLOW}What would you like to do?${NC}"
echo "   1) Download Linux Mint ISO (for a fresh install)"
echo "   2) Create a bootable USB drive (using balenaEtcher)"
echo "   3) Back up your files"
echo "   4) Do everything (recommended)"
echo "   5) Skip to verification"
echo ""
read -p "Choose (1-5): " MINT_CHOICE

case $MINT_CHOICE in
    1|4)
        print_step "Opening Linux Mint download page..."
        xdg-open "https://linuxmint.com/download.php" 2>/dev/null || \
        echo "Please open https://linuxmint.com/download.php in your browser"
        
        echo ""
        print_question "After downloading, drag the ISO file here and press Enter:"
        read -p "ISO path: " ISO_PATH
        
        ISO_PATH=$(echo "$ISO_PATH" | sed "s/^'//;s/'$//")
        
        if [ -f "$ISO_PATH" ]; then
            cp "$ISO_PATH" "$WORKDIR/linuxmint.iso"
            print_success "Linux Mint ISO copied to $WORKDIR/linuxmint.iso"
            MINT_ISO="$WORKDIR/linuxmint.iso"
        fi
        ;;
esac

case $MINT_CHOICE in
    2|4)
        if [[ -z "$MINT_ISO" ]]; then
            print_question "Path to Linux Mint ISO:"
            read -p "ISO path: " MINT_ISO
            MINT_ISO=$(echo "$MINT_ISO" | sed "s/^'//;s/'$//")
        fi
        
        if [[ -f "$MINT_ISO" ]]; then
            echo ""
            print_step "Launching balenaEtcher to create your bootable USB..."
            echo ""
            print_info "In balenaEtcher:"
            echo "   1. Click 'Flash from file' and select your Linux Mint ISO"
            echo "   2. Click 'Select target' and choose your USB drive"
            echo "   3. Click 'Flash!' to create your bootable USB"
            echo ""
            read -p "Press Enter to launch balenaEtcher..."
            
            # Launch balenaEtcher
            balena-etcher-electron &
            
            echo ""
            print_info "After Etcher finishes, you'll have a bootable Linux Mint USB!"
            echo ""
            print_info "To install Linux Mint:"
            echo "   1. Reboot and press F12"
            echo "   2. Select USB drive"
            echo "   3. Choose 'Start Linux Mint'"
            echo "   4. Double-click 'Install Linux Mint' on desktop"
        fi
        ;;
esac

case $MINT_CHOICE in
    3|4)
        echo ""
        print_step "File Backup Assistant"
        echo ""
        print_info "Let's back up your important files!"
        echo ""
        
        # Create backup script
        cat > "$WORKDIR/backup.sh" << 'EOF'
#!/bin/bash
echo "Alienware Backup Script"
echo "======================="
echo ""
echo "Available drives:"
lsblk -o NAME,SIZE,TYPE,MOUNTPOINT,LABEL
echo ""
read -p "Enter backup drive mount point (e.g., /media/you/DRIVE): " BACKUP_PATH

if [ -d "$BACKUP_PATH" ]; then
    BACKUP_DIR="$BACKUP_PATH/alienware-backup-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$BACKUP_DIR"
    
    echo ""
    echo "Backing up to: $BACKUP_DIR"
    echo "This may take a while..."
    
    # Backup important directories
    rsync -avh --progress \
        ~/Documents \
        ~/Pictures \
        ~/Videos \
        ~/Music \
        ~/Downloads \
        ~/.ssh \
        ~/.config \
        "$BACKUP_DIR/" \
        --exclude="*.iso" \
        --exclude="*.img" \
        --exclude="cache"
    
    echo ""
    echo "✅ Backup complete!"
    echo "Your files are at: $BACKUP_DIR"
    echo "$BACKUP_DIR" > ~/alienware-setup/last-backup.txt
else
    echo "❌ Error: $BACKUP_PATH not found"
fi
EOF
        
        chmod +x "$WORKDIR/backup.sh"
        print_success "Backup script created at: $WORKDIR/backup.sh"
        print_info "Run it when you're ready: bash $WORKDIR/backup.sh"
        
        echo ""
        print_question "Run backup now? (yes/no): "
        read -p "> " RUN_BACKUP
        
        if [[ "$RUN_BACKUP" == "yes" ]]; then
            bash "$WORKDIR/backup.sh"
        fi
        ;;
esac

# ============================================================================
# PART 5: FINAL VERIFICATION & OPENCL CHECK
# ============================================================================
clear
echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
print_step "PART 5: Final System Verification"
echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
echo ""

print_step "Running final checks..."

# Check KVM
if [ -e /dev/kvm ]; then
    print_success "✓ KVM is working - virtualization is enabled!"
else
    print_warning "KVM still not detected. This is OK - the message is harmless!"
fi

# Check OpenCL again
print_step "Verifying OpenCL is fixed..."
if command -v clinfo &> /dev/null; then
    if clinfo &> /dev/null; then
        print_success "✓ OpenCL is working correctly!"
    else
        print_warning "OpenCL still has issues. Let me try one more fix..."
        sudo apt install --reinstall -y ocl-icd-libopencl1 intel-opencl-icd
    fi
fi

# Check for broken packages
print_step "Checking for broken packages..."
sudo apt --fix-broken install -y

# Create final README
cat > "$WORKDIR/README.txt" << EOF
ALIENWARE M11X R2 SETUP COMPLETE!

Date: $(date)

WHAT'S BEEN DONE:
✅ System analyzed
✅ OpenCL/KIMI errors fixed
✅ Essential tools installed
✅ BIOS update prepared (if needed)
✅ Linux Mint preparation
✅ Backup tools created

IMPORTANT FILES:
- System info: $WORKDIR/system-info.txt
- BIOS update files: $WORKDIR/bios-update/
- Backup script: $WORKDIR/backup.sh
- Linux Mint ISO: $WORKDIR/linuxmint.iso (if downloaded)

NEXT STEPS:
1. If you want to update BIOS, check $WORKDIR/bios-update/INSTRUCTIONS.txt
2. To backup files: bash $WORKDIR/backup.sh
3. To install Linux Mint, boot from your USB and follow the installer
4. After installing Mint, run: sudo apt update && sudo apt upgrade

NEED HELP?
- Run this script again: bash $WORKDIR/alienware-assistant.sh
- OpenCL issues? Try: sudo apt install --reinstall intel-opencl-icd
- KVM message still there? It's harmless!

Your Alienware is ready! 🚀
EOF

# ============================================================================
# PART 6: SUMMARY
# ============================================================================
echo ""
echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
print_step "🎉 ALL DONE! Here's what I've done for you:"
echo -e "${GREEN}════════════════════════════════════════════════════════════${NC}"
echo ""
echo "✅ Fixed OpenCL/KIMI errors"
echo "✅ Analyzed your system"
echo "✅ Updated your package lists"
echo "✅ Installed essential tools (alternatives for Ubuntu 24.04)"
echo "✅ Prepared BIOS update files (if needed)"
echo "✅ Created backup script"
echo "✅ Downloaded/processed Linux Mint files (if chosen)"
echo ""

echo -e "${YELLOW}📝 Your Files Are Here:${NC}"
echo "  • Working directory: $WORKDIR"
echo "  • System info: $WORKDIR/system-info.txt"
echo "  • BIOS update files: $WORKDIR/bios-update/"
echo "  • Backup script: $WORKDIR/backup.sh"
echo "  • Complete README: $WORKDIR/README.txt"
echo ""

echo -e "${PURPLE}════════════════════════════════════════════════════════════${NC}"
echo -e "${PURPLE}     Your Alienware is now ready for its new life! 🚀${NC}"
echo -e "${PURPLE}════════════════════════════════════════════════════════════${NC}"
echo ""

# Save the script
cp "$0" "$WORKDIR/alienware-assistant.sh"
chmod +x "$WORKDIR/alienware-assistant.sh"
print_success "I've saved myself to: $WORKDIR/alienware-assistant.sh"
echo ""

# Offer cleanup
print_question "Clean up temporary files? (recommended: yes)"
read -p "(yes/no): " CLEANUP

if [[ "$CLEANUP" == "yes" ]]; then
    cd ~
    sudo apt autoremove -y
    sudo apt autoclean -y
    print_success "Cleanup complete!"
fi

echo ""
echo -e "${GREEN}Thank you for using the Alienware Setup Assistant! 🎮${NC}"
echo -e "${GREEN}If you still see KVM messages, remember: they're completely harmless!${NC}"
echo ""
